# Copie para .env (nunca versione o .env)

# Portal da Transparência: chave emitida após autenticação gov.br (nível Prata ou Ouro).
# Documentação: https://api.portaldatransparencia.gov.br/swagger-ui/index.html
# TRANSPARENCIA_API_KEY=

# INMET: token para dados horários observados (confirmar na documentação oficial).
# INMET_TOKEN=

# DataJud (CNJ): chave gratuita obtida por cadastro (confirmar na documentação oficial).
# DATAJUD_API_KEY=
