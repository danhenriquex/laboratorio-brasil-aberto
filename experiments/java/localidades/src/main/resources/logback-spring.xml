<?xml version="1.0" encoding="UTF-8"?>
<!-- Registro de pedidos: uma linha JSON por pedido, só a mensagem (R9). O resto do framework fica em WARN. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="PEDIDOS" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="localidades.pedidos" level="INFO" additivity="false">
        <appender-ref ref="PEDIDOS"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
